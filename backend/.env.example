# Application Configuration
APP_NAME=FinancialOS API
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-super-secret-key-in-production-32bytes

# Database Configuration (PostgreSQL / Supabase)
# For Async SQLAlchemy, use postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Supabase Authentication Settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
